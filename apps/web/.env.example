# StillHunt web — copy to .env.local and fill in.
# Everything here ships to the browser, so nothing secret belongs in this file.

# ── API ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://stillhunt-api-production.up.railway.app
# Local: NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Auth ──────────────────────────────────────────────────────────────────────
# Magic publishable key — email + Google sign-in, deterministic wallet.
# The same address on every EVM chain, which is why a player keeps one identity.
NEXT_PUBLIC_MAGIC_API_KEY=pk_live_...

# Optional: Web3Auth, used ONLY as an external-wallet connector. Do not enable its
# social logins — they would mint a second embedded wallet, so the same person
# signing in two ways would end up with two addresses and two sets of progress.
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# ── Avalanche C-Chain (43114) ─────────────────────────────────────────────────
# Deployed 2026-08-03. See contracts/DEPLOYMENTS.md.
NEXT_PUBLIC_TALLY_ADDRESS=0x670855698cf1137D01F83D6f058F8BC9A74f01e9
NEXT_PUBLIC_MARKETPLACE_ADDRESS=0x105f95c60958f1AaCE8750c5447f585050ABBE5c
NEXT_PUBLIC_DUELS_ADDRESS=0x87f5F346F09849404274DE01962C36667E2E2830
NEXT_PUBLIC_GAME_RECORD_ADDRESS=0x6D4e61b683337b3C8Bd3A04738586aC1F86f8d3a

# Read RPC. The default in config/chain.ts works; set a private endpoint if the
# public one starts rate-limiting, which reads to a player as the app being broken.
NEXT_PUBLIC_RPC_URL=

# The backend relay's public address — the `spender` in every permit the player
# signs. NOT a key.
NEXT_PUBLIC_RELAY_ADDRESS=0x380d056654cEd771e6f3Fa014E7D3866cEE89593
