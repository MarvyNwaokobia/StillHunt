# StillHunt contracts — copy to contracts/.env and fill in.
#
# contracts/.env is gitignored and must STAY that way. The repo this project
# grew out of shipped a live relay key in a committed script, and that key owned
# every contract and ~150,000 G$ across two reward pools. Nothing here is worth
# repeating that for. If a key ever lands in a commit, rotating it is mandatory —
# scrubbing history is not a substitute, because the commit is already public.

# ── Deploy ────────────────────────────────────────────────────────────────────
# The wallet that pays for the deploy and BECOMES THE OWNER of every proxy.
# Owner carries _authorizeUpgrade on all four UUPS proxies, so this key can
# replace any implementation. Treat it as cold: use it for the deploy, then
# consider transferring ownership to a Safe multisig.
# Needs roughly 0.002 AVAX — the full deploy measured 10,230,423 gas on a fork.
DEPLOYER_PRIVATE_KEY=

# The backend wallet. Mints TALLY, records matches, and resolves duels.
# MUST NOT be the deployer: it is hot (it signs continuously from the API), and
# separating them means a compromised relay cannot upgrade a contract.
# Keep it funded with AVAX — a relay that runs dry stops payouts silently, which
# is the single most repeated production failure in this codebase's history.
RELAY_ADDRESS=

# ── Network ───────────────────────────────────────────────────────────────────
# A public endpoint is fine for a dry run. Use a private RPC before --broadcast:
# public endpoints rate-limit, and a deploy that dies halfway leaves orphan
# contracts you have already paid for.
AVALANCHE_RPC_URL=https://avalanche-c-chain-rpc.publicnode.com
AVALANCHE_TESTNET_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Snowtrace verification. Routescan accepts the literal string "verifyContract",
# so no real key is needed — but do not skip --verify. An unverified contract is
# unreadable to a player, an auditor or a grant reviewer.
SNOWTRACE_API_KEY=verifyContract

# ── Filled in from Deploy.s.sol output. Copy them, never retype them. ──────────
TALLY_ADDRESS=
ARMORY_ADDRESS=
MARKETPLACE_ADDRESS=
DUELS_ADDRESS=
RECORD_ADDRESS=

# Avalanche C-Chain id, for reference only. The code does NOT read this:
# config/chain.ts holds 43114 as a constant, because a chain id is a fixed fact
# and a value read from here could be set wrong and would then happily approve a
# deploy to the wrong chain.
AVALANCHE_CHAIN_ID=43114
